OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5

# Optional Google Calendar OAuth client file
# CORTANA_GOOGLE_OAUTH_CLIENT_FILE=

# Optional voice settings
# CORTANA_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# CORTANA_TTS_MODEL=gpt-4o-mini-tts
# CORTANA_TTS_VOICE=coral

# Optional realtime voice settings
# CORTANA_REALTIME_MODEL=gpt-realtime-mini
# CORTANA_REALTIME_VOICE=coral

# Optional isolated pilot/demo data directory.
# Use only for a dedicated profile. Do not point this at directories
# that contain unrelated files. Unset uses the normal app-data location.
# CORTANA_DATA_DIR=
